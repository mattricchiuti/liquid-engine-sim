# Virtual environment
.venv/

# Python bytecode and caches
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Build artifacts
build/
dist/
*.egg-info/

# PyCharm per-user files (shared project settings stay tracked)
.idea/workspace.xml
.idea/shelf/
.idea/usage.statistics.xml
.idea/dataSources*
.idea/httpRequests/

# LibreOffice / Excel lock files while a spreadsheet is open
.~lock.*#
~$*

# OS clutter
Thumbs.db
Desktop.ini
.DS_Store
